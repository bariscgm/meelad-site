{
  "name": "meelad-fest-site",
  "version": "1.0.0",
  "description": "Meelad Fest Arts & Cultural Competition Web Portal - MERN / MVC Architecture",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "npm start --prefix server",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm install && npm run build"
  },
  "keywords": [
    "mvc",
    "meelad-fest",
    "competition-scoring",
    "leaderboard",
    "mern"
  ],
  "author": "Meelad Tech Committee",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
